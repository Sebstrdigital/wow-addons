---
const { title = "Stand as One's Playbook" } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #14161a;
        --panel: #1d2026;
        --panel-2: #23272f;
        --border: #2c313a;
        --text: #e8e8e8;
        --dim: #9d9d9d;
        --gold: #ffd100;
        --tank: #4a9eff;
        --healer: #3fd47f;
        --dps: #ff9333;
        --wipe: #ff5050;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font: 16px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif;
      }
      a { color: var(--gold); text-decoration: none; }
      a:hover { text-decoration: underline; }
      header.site {
        display: flex; align-items: baseline; gap: 12px;
        padding: 14px 22px;
        background: var(--panel);
        border-bottom: 1px solid var(--border);
      }
      header.site .brand { font-size: 20px; font-weight: 700; color: var(--gold); }
      header.site .tag { color: var(--dim); font-size: 13px; margin-left: auto; }
      header.site .topnav { display: flex; gap: 16px; margin-left: 18px; }
      header.site .topnav a { color: var(--text); font-weight: 600; }
      header.site .topnav a:hover { color: var(--gold); text-decoration: none; }
      main { max-width: 1180px; margin: 0 auto; padding: 22px; }
      h1 { color: var(--gold); margin: 0 0 4px; }
      h2 { color: var(--gold); border-bottom: 1px solid var(--border); padding-bottom: 6px; margin-top: 38px; }
      .dim { color: var(--dim); }
      .card {
        background: var(--panel); border: 1px solid var(--border);
        border-radius: 10px; padding: 18px 22px; margin: 14px 0;
      }
      .role-TANK { color: var(--tank); }
      .role-HEALER { color: var(--healer); }
      .role-DPS { color: var(--dps); }
      .wipe { color: var(--wipe); }
      .ability-link { color: #dfa55a; }
      a.ability-link:hover { text-decoration: underline; }
      ul { margin: 6px 0 14px; padding-left: 22px; }
      li { margin: 3px 0; }
    </style>
  </head>
  <body>
    <header class="site">
      <a class="brand" href={base}>Stand as One's Playbook</a>
      <nav class="topnav">
        <a href={base}>Playbooks</a>
        <a href={`${base}/routes/`}>Routes</a>
      </nav>
      <span class="tag">Mythic+ second screen</span>
    </header>
    <main><slot /></main>
  </body>
</html>
