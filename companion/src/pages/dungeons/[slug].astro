---
import Base from "../../layouts/Base.astro";
import { loadDungeons, loadMdtData, loadAbilities, mapUrlFor } from "../../lib/content.js";
import { renderAbilityMarkup } from "../../lib/markup.js";
import RoutePanel from "../../components/RoutePanel.astro";

export function getStaticPaths() {
  return loadDungeons().map((d) => ({ params: { slug: d.slug }, props: { dungeon: d } }));
}

const { dungeon: d } = Astro.props;
const mdt = loadMdtData(d.slug);
const abilities = loadAbilities();
const mk = (text) => renderAbilityMarkup(text, abilities);
const mdtPayload = mdt ? { ...mdt, name: d.dungeon, mapUrl: mapUrlFor(d.slug, import.meta.env.BASE_URL) } : null;
const ROLES = ["TANK", "HEALER", "DPS"];
const ROLE_LABEL = { TANK: "Tank", HEALER: "Healer", DPS: "DPS" };

function overviewSections(o, role) {
  const s = [];
  s.push({
    title: "Interrupt first", cls: "gold",
    items: (o.interrupts ?? []).map((it, i) => `${i + 1}. ${it.spell}${it.note ? ` — ${it.note}` : ""}`),
  });
  if (role !== "HEALER") {
    s.push({ title: "Kill first", cls: "gold", items: (o.killPriority ?? []).map((n, i) => `${i + 1}. ${n}`) });
  }
  if (role === "TANK" && o.tank) {
    s.push({ title: "Dangerous tank damage", cls: `role-${role}`, items: o.tank.damage ?? [] });
    s.push({ title: "Pull warnings", cls: "wipe", items: o.tank.pullWarnings ?? [] });
  } else if (role === "HEALER" && o.healer) {
    s.push({ title: "Dispel first", cls: `role-${role}`, items: o.healer.dispels ?? [] });
    s.push({ title: "Biggest healing pressure", cls: `role-${role}`, items: o.healer.pressure ?? [] });
    s.push({ title: "Pull warnings", cls: "wipe", items: o.healer.pullWarnings ?? [] });
  } else if (role === "DPS" && o.dps) {
    s.push({ title: "Purge and control", cls: `role-${role}`, items: o.dps.purges ?? [] });
    s.push({ title: "Personal defensive warnings", cls: "wipe", items: o.dps.defensives ?? [] });
    s.push({ title: "Pull warnings", cls: "wipe", items: o.dps.pullWarnings ?? [] });
  }
  if (o.tip) s.push({ title: "Practical tip", cls: "gold", items: Array.isArray(o.tip) ? o.tip : [o.tip] });
  return s.filter((sec) => sec.items.length);
}

function bossSections(boss, role) {
  const body = boss.roles?.[role];
  const s = [];
  if (body) {
    s.push({ title: "Your job", cls: `role-${role}`, items: body.job ?? [] });
    if (body.avoid?.length) s.push({ title: "Avoid", cls: `role-${role}`, items: body.avoid });
    const def = body.defensive ?? body.cooldowns;
    if (def?.length) s.push({ title: role === "HEALER" ? "Cooldowns" : "Defensives", cls: `role-${role}`, items: def });
  }
  if (boss.wipe?.length) s.push({ title: "Wipe mechanic", cls: "wipe", items: boss.wipe });
  return s;
}
---
<Base title={`${d.dungeon} — Stand as One's Playbook`}>
  <h1>{d.dungeon}</h1>
  <p class="dim">{d.season} · patch {d.patch} · playbook v{d.sourceVersion}</p>

  <div class="role-tabs">
    {ROLES.map((r) => (
      <button class={`role-tab role-${r}`} data-role-tab={r}>{ROLE_LABEL[r]}</button>
    ))}
  </div>

  <nav class="jump dim">
    Jump to:
    {d.quicksheet && <span><a href="#quicksheet">Quick sheet</a> · </span>}
    <a href="#overview">Overview & Trash</a> · <a href="#route">Route</a>
    {(d.minibosses ?? []).map((b, i) => (<span> · <a href={`#mb-${i + 1}`}>★ {b.name}</a></span>))}
    {d.bosses.map((b, i) => (<span> · <a href={`#boss-${i + 1}`}>{b.name}</a></span>))}
  </nav>

  {d.quicksheet && (
    <section>
      <h2 id="quicksheet">Quick sheet <span class="dim" style="font-size:15px">all roles — know each other's jobs</span></h2>
      <div class="card">
        {d.quicksheet.trash && (
          <div>
            <h3 class="gold">Priority trash calls</h3>
            {["TANK", "HEALER", "DPS", "ROUTE"].map((r) =>
              d.quicksheet.trash[r] && (
                <p class="qs-line"><strong class={r === "ROUTE" ? "gold" : `role-${r}`}>{r}:</strong> <span set:html={mk(d.quicksheet.trash[r])} /></p>
              ))}
          </div>
        )}
        {[...(d.minibosses ?? []), ...d.bosses].filter((b) => b.sheet).map((b, i) => (
          <div class="qs-boss">
            <h3 class="gold">{i + 1} · {b.name}</h3>
            {["TANK", "HEALER", "DPS"].map((r) =>
              b.sheet[r] && <p class="qs-line"><strong class={`role-${r}`}>{r}:</strong> <span set:html={mk(b.sheet[r])} /></p>)}
            {b.sheet.WIPE && <p class="qs-line wipe"><strong>WIPE:</strong> <span set:html={mk(b.sheet.WIPE)} /></p>}
          </div>
        ))}
      </div>
    </section>
  )}

  <h2 id="overview">Dungeon overview & trash</h2>
  {ROLES.map((role) => (
    <div class="role-pane card" data-role={role}>
      {overviewSections(d.overview ?? {}, role).map((sec) => (
        <div>
          <h3 class={sec.cls}>{sec.title}</h3>
          <ul>{sec.items.map((it) => <li set:html={mk(it)} />)}</ul>
        </div>
      ))}
    </div>
  ))}

  <h2 id="route">Route</h2>
  <RoutePanel payload={mdtPayload} />

  {(d.minibosses ?? []).map((b, i) => (
    <section>
      <h2 id={`mb-${i + 1}`}>★ {b.name} <span class="dim" style="font-size:15px">mini-boss</span></h2>
      {ROLES.map((role) => (
        <div class="role-pane card" data-role={role}>
          {b.roles?.[role]?.reminder && <p class={`reminder role-${role}`} set:html={mk(b.roles[role].reminder)} />}
          {bossSections(b, role).map((sec) => (
            <div>
              <h3 class={sec.cls}>{sec.title}</h3>
              <ul class={sec.cls === "wipe" ? "wipe" : ""}>{sec.items.map((it) => <li set:html={mk(it)} />)}</ul>
            </div>
          ))}
        </div>
      ))}
    </section>
  ))}

  {d.bosses.map((b, i) => (
    <section>
      <h2 id={`boss-${i + 1}`}>{i + 1}. {b.name}</h2>
      {ROLES.map((role) => (
        <div class="role-pane card" data-role={role}>
          {b.roles?.[role]?.reminder && <p class={`reminder role-${role}`} set:html={mk(b.roles[role].reminder)} />}
          {bossSections(b, role).map((sec) => (
            <div>
              <h3 class={sec.cls}>{sec.title}</h3>
              <ul class={sec.cls === "wipe" ? "wipe" : ""}>{sec.items.map((it) => <li set:html={mk(it)} />)}</ul>
            </div>
          ))}
        </div>
      ))}
    </section>
  ))}

  <style>
    .role-tabs { display: flex; gap: 8px; margin: 18px 0 6px; position: sticky; top: 0; background: var(--bg); padding: 10px 0; z-index: 5; }
    .role-tab {
      background: var(--panel-2); color: inherit; border: 1px solid var(--border);
      border-radius: 8px; padding: 8px 22px; font-size: 16px; font-weight: 600; cursor: pointer; opacity: 0.55;
    }
    .role-tab.active { opacity: 1; border-color: currentColor; }
    .jump { font-size: 14px; margin-bottom: 6px; }
    .qs-line { margin: 3px 0; }
    .qs-boss { margin-top: 14px; }
    h3 { margin: 14px 0 4px; font-size: 15px; text-transform: uppercase; letter-spacing: 0.04em; }
    h3.gold { color: var(--gold); }
    .reminder { font-size: 18px; font-weight: 700; margin: 2px 0 10px; }
    .role-pane { display: none; }
    body[data-role="TANK"] :global(.role-pane[data-role="TANK"]),
    body[data-role="HEALER"] :global(.role-pane[data-role="HEALER"]),
    body[data-role="DPS"] :global(.role-pane[data-role="DPS"]) { display: block; }
  </style>

  <script>
    // --- role tabs ---------------------------------------------------------
    const tabs = document.querySelectorAll("[data-role-tab]");
    function setRole(r) {
      localStorage.setItem("gp-role", r);
      document.body.dataset.role = r;
      tabs.forEach((t) => t.classList.toggle("active", t.dataset.roleTab === r));
    }
    setRole(localStorage.getItem("gp-role") || "TANK");
    tabs.forEach((t) => t.addEventListener("click", () => setRole(t.dataset.roleTab)));
  </script>

</Base>
