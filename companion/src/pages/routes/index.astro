---
import Base from "../../layouts/Base.astro";
import { loadDungeons, loadMdtSlugs } from "../../lib/content.js";

const playbooks = new Map(loadDungeons().map((d) => [d.slug, d]));
const entries = loadMdtSlugs().map((slug) => ({
  slug,
  name: playbooks.get(slug)?.dungeon
    ?? slug.split("-").map((w) => w[0].toUpperCase() + w.slice(1)).join(" "),
  hasPlaybook: playbooks.has(slug),
}));
const base = import.meta.env.BASE_URL;
---
<Base title="Routes — Raven's Guild Playbook">
  <h1>Routes</h1>
  <p class="dim">
    MDT route viewer for any dungeon with map data — works even before a playbook exists.
    Paste an export string, see the pulls on the map.
  </p>
  {entries.map((e) => (
    <a class="card dungeon-card" href={`${base}/routes/${e.slug}/`}>
      <strong>{e.name}</strong>
      {e.hasPlaybook && <span class="dim"> — playbook available</span>}
    </a>
  ))}
  {entries.length === 0 && <p class="dim">No dungeon map data yet.</p>}
  <style>
    .dungeon-card { display: block; color: var(--text); font-size: 18px; }
    .dungeon-card:hover { border-color: var(--gold); text-decoration: none; }
  </style>
</Base>
