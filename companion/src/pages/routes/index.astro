---
import Base from "../../layouts/Base.astro";
import RoutePanel from "../../components/RoutePanel.astro";
import { loadDungeons, loadMdtData, loadMdtSlugs } from "../../lib/content.js";
import fs from "node:fs";

const playbooks = new Map(loadDungeons().map((d) => [d.slug, d]));
const dungeons = {};
const names = [];
for (const slug of loadMdtSlugs()) {
  const mdt = loadMdtData(slug);
  if (!mdt) continue;
  const name = playbooks.get(slug)?.dungeon
    ?? slug.split("-").map((w) => w[0].toUpperCase() + w.slice(1)).join(" ");
  const hasMap = fs.existsSync(new URL(`../../../public/maps/${slug}.webp`, import.meta.url));
  dungeons[mdt.dungeonIndex] = {
    ...mdt,
    name,
    mapUrl: hasMap ? `${import.meta.env.BASE_URL}/maps/${slug}.webp` : null,
  };
  names.push(name);
}
const registry = { registry: true, dungeons };
---
<Base title="Routes — Raven's Guild Playbook">
  <h1>Routes</h1>
  <p class="dim">
    Paste any MDT export string — the dungeon is detected automatically and the route renders
    on its map. Supported so far: {names.join(", ")}.
  </p>
  <RoutePanel payload={registry} />
</Base>
