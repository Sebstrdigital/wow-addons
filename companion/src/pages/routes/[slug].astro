---
import Base from "../../layouts/Base.astro";
import RoutePanel from "../../components/RoutePanel.astro";
import { loadDungeons, loadMdtData, loadMdtSlugs, mapUrlFor } from "../../lib/content.js";

export function getStaticPaths() {
  return loadMdtSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const playbook = loadDungeons().find((d) => d.slug === slug);
const mdt = loadMdtData(slug);
const name = playbook?.dungeon ?? mdt?.name
  ?? slug.split("-").map((w) => w[0].toUpperCase() + w.slice(1)).join(" ");
const mdtPayload = mdt ? { ...mdt, name, mapUrl: mapUrlFor(slug, import.meta.env.BASE_URL) } : null;
const base = import.meta.env.BASE_URL;
---
<Base title={`${name} route — Raven's Guild Playbook`}>
  <h1>{name} — Route</h1>
  <p class="dim">
    {playbook
      ? <span>Tactics playbook: <a href={`${base}/dungeons/${slug}/`}>open {name} playbook</a></span>
      : "No playbook for this dungeon yet — route viewer only."}
  </p>
  <RoutePanel payload={mdtPayload} />
</Base>
